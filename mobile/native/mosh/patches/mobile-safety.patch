diff --git a/src/frontend/agentport-size.h b/src/frontend/agentport-size.h
new file mode 100644
--- /dev/null
+++ b/src/frontend/agentport-size.h
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#ifndef AGENTPORT_SIZE_H
+#define AGENTPORT_SIZE_H
+#include <stdint.h>
+#include <sys/ioctl.h>
+// Rust owns a stable AtomicU32. Only this atomic load crosses the thread
+// boundary; plain winsize fields belong exclusively to the Mosh event loop.
+inline struct winsize agentport_read_size(const uint32_t* packed) {
+  const uint32_t value = __atomic_load_n(packed, __ATOMIC_ACQUIRE);
+  struct winsize size = {};
+  size.ws_col = static_cast<unsigned short>(value >> 16);
+  size.ws_row = static_cast<unsigned short>(value & 0xffff);
+  return size;
+}
+#endif
