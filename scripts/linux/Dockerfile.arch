# Arch Linux (release snapshot, community-verified tier): build + tarball.
FROM archlinux:latest
# pacman's seccomp sandbox fails under x86_64 emulation (QEMU/Rosetta).
RUN printf '\n[options]\nDisableSandbox\n' >> /etc/pacman.conf
RUN pacman -Syu --noconfirm --needed \
    curl git base-devel pkgconf \
    webkit2gtk-4.1 openssl libappindicator-gtk3 librsvg xdotool dbus xdg-utils nodejs npm
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src
COPY . .
RUN cargo build --release -p agentport-host -p agentport-remote-bridge -p agentport-mosh-attach -p agentport-cli \
 && cargo build --release -p agentport-relay --features agentport-relay/connector
RUN mkdir -p /out \
 && cp target/release/agentport-cli target/release/agentport-host target/release/agentport-remote-bridge target/release/agentport-mosh-attach target/release/agentport-connector /out/ \
 && tar -czf /out/agentport-arch-$(uname -m).tar.gz -C /out agentport-cli agentport-host agentport-remote-bridge agentport-mosh-attach agentport-connector
WORKDIR /out
CMD ["ls", "-la", "/out"]
