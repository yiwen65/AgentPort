{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentPort",
  "version": "0.1.0",
  "identifier": "com.agentport.desktop",
  "build": {
    "beforeDevCommand": "bash src-tauri/scripts/build-sidecar.sh debug && npm --prefix src run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash src-tauri/scripts/build-sidecar.sh release && npm --prefix src run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AgentPort",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "transparent": true,
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon-runtime-8bit.png", "icons/icon.icns"],
    "externalBin": ["binaries/agentport-host", "binaries/agentport-remote-bridge", "binaries/agentport-mosh-attach", "binaries/agentport-connector"],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": ["git"],
        "recommends": ["libnotify-bin", "xdg-utils", "xterm"]
      }
    }
  }
}
